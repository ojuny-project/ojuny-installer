+qint64
+createSwapPartition( PartitionCoreModule* core,
+                     Device* dev,
+                     PartitionNode* parent,
+                     const PartitionRole& role,
+                     qint64 firstSector,
+                     qint64 lastSector,
+                     Config::SwapChoice swap,
+                     Config::LuksGeneration luksFsType,
+                     const QString& luksPassphrase )
+{
+    qint64 lastSectorForRoot = lastSector;
+    if ( ( swap != Config::SwapChoice::SmallSwap ) && ( swap != Config::SwapChoice::FullSwap ) )
+    {
+        return lastSectorForRoot;
+    }
+
+    const qint64 sectorSize = dev->logicalSize();
+    const quint64 availableSpaceB = quint64( lastSector - firstSector + 1 ) * quint64( sectorSize );
+    const quint64 suggestedSwapSizeB = swapSuggestion( availableSpaceB, swap );
+    if ( suggestedSwapSizeB == 0 )
+    {
+        return lastSectorForRoot;
+    }
+
+    Calamares::GlobalStorage* gs = Calamares::JobQueue::instance()->globalStorage();
+    const quint64 requiredSpaceB = Calamares::GiBtoBytes( gs->value( "requiredStorageGiB" ).toDouble() );
+    if ( availableSpaceB <= requiredSpaceB + 600_MiB + suggestedSwapSizeB )
+    {
+        return lastSectorForRoot;
+    }
+
+    const auto sectorsForSwap = suggestedSwapSizeB / sectorSize + 1;
+    lastSectorForRoot = Calamares::Partition::alignEndSectorTo4K( sectorSize, lastSectorForRoot - sectorsForSwap );
+
+    Partition* swapPartition = nullptr;
+    if ( luksPassphrase.isEmpty() )
+    {
+        swapPartition = KPMHelpers::createNewPartition( parent,
+                                                        *dev,
+                                                        role,
+                                                        FileSystem::LinuxSwap,
+                                                        QStringLiteral( "swap" ),
+                                                        lastSectorForRoot + 1,
+                                                        lastSector,
+                                                        KPM_PARTITION_FLAG( None ) );
+    }
+    else
+    {
+        swapPartition = KPMHelpers::createNewEncryptedPartition( parent,
+                                                                 *dev,
+                                                                 role,
+                                                                 FileSystem::LinuxSwap,
+                                                                 QStringLiteral( "swap" ),
+                                                                 lastSectorForRoot + 1,
+                                                                 lastSector,
+                                                                 luksFsType,
+                                                                 luksPassphrase,
+                                                                 KPM_PARTITION_FLAG( None ) );
+    }
+    PartitionInfo::setFormat( swapPartition, true );
+    if ( gs->contains( "swapPartitionName" ) )
+    {
+        swapPartition->setLabel( gs->value( "swapPartitionName" ).toString() );
+    }
+    core->createPartition( dev, swapPartition );
+
+    return lastSectorForRoot;
+}
